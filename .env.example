# Local development only. `make dev` copies this file to .env on first run and replaces every
# value "change-me" with a random secret, so no shared default credentials exist.

POSTGRES_DB=isrisk
POSTGRES_USER=isrisk
POSTGRES_PASSWORD=change-me
# Restricted role the application connects with (manage.py setup_db_roles)
POSTGRES_APP_USER=isrisk_app
POSTGRES_APP_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Keycloak admin console: http://localhost:8080/admin (user: admin)
KEYCLOAK_ADMIN_PASSWORD=change-me
# Shared secret of the OIDC client; Keycloak imports it from the realm file
OIDC_RP_CLIENT_SECRET=change-me
# Password of all demo accounts in the realm "is-risk"
DEMO_USER_PASSWORD=change-me

# Notifications: the worker sends through the notify-gateway service; e-mails end up in
# Mailpit (http://localhost:8025), SMS in the gateway log
APP_BASE_URL=http://localhost:8000
IR_TEAM_EMAILS=ir-team@example.org
IR_TEAM_PHONES=+49 30 1234567
IT_OPS_EMAIL=it-ops@example.org
NOTIFY_GATEWAY_TOKEN=change-me
# none | timeout | 5xx — force a gateway outage (AK-03.3), then: docker compose up -d notify-gateway
NOTIFY_FAILURE_MODE=none
# Only for the in-process mock used by the tests: ok | timeout | 5xx
NOTIFY_MOCK_MODE=ok
