# Local development only. `make dev` copies this file to .env on first run and replaces every
# value "change-me" with a random secret, so no shared default credentials exist.

POSTGRES_DB=isrisk
POSTGRES_USER=isrisk
POSTGRES_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Keycloak admin console: http://localhost:8080/admin (user: admin)
KEYCLOAK_ADMIN_PASSWORD=change-me
# Shared secret of the OIDC client; Keycloak imports it from the realm file
OIDC_RP_CLIENT_SECRET=change-me
# Password of all demo accounts in the realm "is-risk"
DEMO_USER_PASSWORD=change-me

# Notifications (iteration 2: mock gateway, nothing is sent)
APP_BASE_URL=http://localhost:8000
IR_TEAM_EMAILS=ir-team@example.org
IR_TEAM_PHONES=+49 30 1234567
IT_OPS_EMAIL=it-ops@example.org
# ok | timeout | 5xx — force a gateway failure to see AK-03.3
NOTIFY_MOCK_MODE=ok
